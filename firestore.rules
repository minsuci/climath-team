rules_version = '2';
// climath-team — 대시보드 전용 DB. 관리자(owner) 토큰만 읽고 쓴다.
// /api/auth 가 수업관리 앱에서 owner 임을 확인한 뒤에만 이 프로젝트 토큰을 발급한다.
// 적용은 Firebase 콘솔 → climath-team → Firestore Database → 규칙에 붙여넣고 게시.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.role == "owner";
    }
  }
}
